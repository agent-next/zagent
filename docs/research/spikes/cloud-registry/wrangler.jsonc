{
  "name": "zagent-fuzz-cloud",
  "main": "containers-worker.js",
  "compatibility_date": "2026-08-28",
  "d1_databases": [
    { "binding": "DB", "database_name": "fuzz-registry", "database_id": "<set by: wrangler d1 create fuzz-registry>" }
  ],
  "containers": [
    {
      "class_name": "FuzzAgent",
      "image": "./Dockerfile",
      // 54 MiB measured peak RSS; `lite` is 256 MiB and 1/16 vCPU.
      "instance_type": "lite",
      "max_instances": 1000
    }
  ],
  "durable_objects": { "bindings": [{ "name": "FUZZ_AGENT", "class_name": "FuzzAgent" }] },
  "workflows": [{ "name": "fuzz-loop", "binding": "FUZZ_LOOP", "class_name": "FuzzLoop",
                  "schedules": ["*/30 * * * *"] }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FuzzAgent"] }],
  "vars": { "MAX_AGENTS": "100" }
}
