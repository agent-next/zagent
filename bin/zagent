#!/usr/bin/env node
// zagent — single entry (also installed as `za`).
//
// This was a bash script. npm generated a .cmd shim for it on Windows that
// resolves the interpreter to `bash`, so `npm install -g zagent` succeeded there
// and every invocation then died with "'bash' is not recognized" — while
// package.json declared no `os` field, so npm issued no warning and the README
// advertised cross-platform support. It also used `readlink -f`, which BSD
// readlink (older macOS) does not support: `$R` silently became the parent of the
// cwd rather than the package root.
//
// Node is already a hard dependency, so the dispatcher is written in it.

import { spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { commandFor, formatRow, ENTRY_FLAGS, HEADLESS_OPTIONS, COMMAND_DETAILS } from '../packages/cli/commands.mjs';
import { findRuntime } from '../packages/driver/runtime.mjs';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const [command, ...rest] = process.argv.slice(2);

/** Subcommand -> the script that implements it, and whether it needs node:sqlite. */
const ROUTES = {
  quota: ['bin/zagent-quota'],
  // --no-warnings: node prints "SQLite is an experimental feature" on stderr for
  // every run, which is noise the user can do nothing about and which corrupts
  // otherwise-parseable output.
  sessions: ['bin/zagent-sessions', '--experimental-sqlite', '--no-warnings'],
  diff: ['packages/cli/zagent-diff.mjs'],
  onboard: ['packages/cli/zagent-onboard.mjs'],
  cron: ['packages/cli/zagent-cron.mjs', '--experimental-sqlite', '--no-warnings'],
  automation: ['packages/cli/zagent-automation.mjs', '--experimental-sqlite', '--no-warnings'],
  bots: ['packages/cli/zagent-bots.mjs'],
  task: ['packages/cli/zagent-task.mjs', '--experimental-sqlite', '--no-warnings'],
  memory: ['packages/cli/zagent-memory.mjs'],
  offpeak: ['packages/cli/zagent-offpeak.mjs'],
  models: ['packages/cli/zagent-models.mjs'],
  help: ['packages/cli/zagent-help.mjs'],
  plugins: ['packages/cli/zagent-plugins.mjs'],
  hooks: ['packages/cli/zagent-hooks.mjs'],
  inspect: ['packages/cli/zagent-inspect.mjs', '--experimental-sqlite', '--no-warnings'],
  import: ['packages/cli/zagent-import.mjs'],
  goal: ['packages/cli/zagent-goal.mjs', '--experimental-sqlite', '--no-warnings'],
  subagents: ['packages/cli/zagent-subagents.mjs', '--experimental-sqlite', '--no-warnings'],
  usage: ['packages/cli/zagent-usage.mjs', '--experimental-sqlite', '--no-warnings'],
  rewind: ['packages/cli/zagent-rewind.mjs', '--experimental-sqlite', '--no-warnings'],
  remote: ['packages/cli/zagent-remote.mjs'],
  update: ['packages/cli/zagent-update.mjs'],
  'commit-msg': ['packages/cli/zagent-commit-msg.mjs'],
  mcp: ['packages/cli/zagent-mcp.mjs'],
};

/** Present in the source repo, deliberately not part of this distribution. */
const SOURCE_ONLY = new Set(['telegram', 'feishu', 'wechat', 'compact', 'dcompact', 'plugin-validate']);

/** Run a script under this same Node and inherit its exit status. */
const run = (script, nodeArgs = [], args = []) => {
  const r = spawnSync(process.execPath, [...nodeArgs, path.join(root, script), ...args], { stdio: 'inherit' });
  if (r.error) { console.error(`zagent: ${r.error.message}`); process.exit(1); }
  // A signal death is a failure, not a success.
  process.exit(r.status ?? (r.signal ? 1 : 0));
};

/** Best-effort kernel version (`node <entry> --version`); '' when unknown. */
const kernelVersion = (entry) => {
  try {
    const r = spawnSync(process.execPath, [entry, '--version'], { encoding: 'utf8', timeout: 5000 });
    const m = String(r.stdout ?? '').match(/(\d+\.\d+[\w.-]*)/);
    return r.status === 0 && m ? m[1] : '';
  } catch { return ''; }
};

if (command === '--version' || command === '-V' || command === '-v' || command === 'version') {
  process.stdout.write(`zagent ${JSON.parse(readFileSync(path.join(root, 'package.json'), 'utf8')).version}\n`);
  const rt = findRuntime();
  if (rt) {
    // rt.version is the installed product version; the kernel's own --version
    // is its internal string, so it is only a fallback and stays labeled.
    let v = rt.version;
    if (!v) { const k = kernelVersion(rt.entry); v = k ? `(kernel ${k})` : null; }
    process.stdout.write(`runtime: ${rt.kind}${v ? ` ${v}` : ''} (${rt.entry})\n`);
  }
  process.exit(0);
}
if (command === '--help' || command === '-h') run('packages/cli/zagent-help.mjs');
if (SOURCE_ONLY.has(command)) {
  console.error(`zagent: ${command} is source-only experimental functionality, not included in this public candidate.`);
  process.exit(2);
}
// `zagent <cmd> --help` used to be passed through to the subcommand, which had no
// notion of it: `models --help` searched the catalog for a model named "--help",
// found none, and printed NOTHING with exit 0; `diff --help` read it as a session
// id; `plugins --help` as a plugin name. Answer it here, once, from the same table
// the palette prints, rather than teaching eleven scripts the same flag.
const HELP_FLAGS = new Set(['--help', '-h']);
// Only before a `--` separator. Otherwise a subcommand that takes free text —
// `zagent memory append` — could never be given the literal string "--help",
// because the dispatcher would answer it as a help request and never run.
// `zagent memory append -- --help` appends the text, as POSIX users expect.
const sep = rest.indexOf('--');
const flagArgs = sep === -1 ? rest : rest.slice(0, sep);
// `zagent -p --help` (or any entry flag + --help) prints the verified headless
// option list: forwarding it would show the kernel's own usage, which names the
// wrong product and documents flags its parser rejects. A literal "--help" can
// therefore never be an entry flag's VALUE in leading position (`--prompt
// --help` prints this help) — the `--` separator escapes that, same tradeoff
// the free-text subcommands make above.
const headlessHelp = () => {
  console.log(formatRow(commandFor('-p')).trimStart());
  console.log('\noptions forwarded to the runtime (verified against its parser):');
  for (const [sig, desc] of HEADLESS_OPTIONS) console.log(`  ${sig.padEnd(48)} ${desc}`);
  console.log('\nnot implemented by the runtime despite its own --help:');
  console.log('  --print --max-turns --allowed-tools --permission-mode --settings --allow-main-worktree-yolo');
};
// The kernel's parser (node parseArgs) also takes `--flag=value`; match the
// option name only, so `zagent --mode=plan -p "…"` forwards like `--mode plan`.
const entryFlag = (token) => ENTRY_FLAGS.has(token?.split('=')[0]);
// Closest known flag for a typo message — bounded edit distance, so '--efort'
// names '--effort' while '--xyz123' gets no bogus suggestion.
const editDistance = (a, b) => {
  const d = Array.from({ length: a.length + 1 }, (_, i) => [i, ...Array(b.length).fill(0)]);
  for (let j = 1; j <= b.length; j++) d[0][j] = j;
  for (let i = 1; i <= a.length; i++)
    for (let j = 1; j <= b.length; j++)
      d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
  return d[a.length][b.length];
};
const SUGGEST_FLAGS = new Set([...ENTRY_FLAGS, '--version', '--help'].filter(f => f.startsWith('--')));
const didYouMean = (name) => {
  if (!name.startsWith('--')) return ''; // short typos are unguessable: -x is 1 edit from -p/-c/-f/-v
  let best = null, dist = 3; // strictly under 3 edits
  for (const f of SUGGEST_FLAGS) {
    const d = editDistance(name, f);
    if (d < dist) { best = f; dist = d; }
  }
  return best ? ` — did you mean '${best}'?` : '';
};
if (flagArgs.some(a => HELP_FLAGS.has(a))) {
  if (entryFlag(command)) { headlessHelp(); process.exit(0); }
  const row = commandFor(command);
  const details = COMMAND_DETAILS[command];
  if (row || details) {
    // The row's signature is the usage line; COMMAND_DETAILS adds the flag
    // notes and one example a bare row never gave (FLOCK-F2: a one-line
    // answer taught the user nothing). app-server/help have no row — their
    // detail block answers here instead of leaking the kernel's usage.
    if (row) console.log(formatRow(row).trimStart());
    else console.log(`usage: zagent ${command}`);
    if (details?.length) console.log(`\n${details.join('\n')}`);
    process.exit(0);
  }
}
if (Object.hasOwn(ROUTES, command)) {
  const [script, ...nodeArgs] = ROUTES[command];
  // Consume the separator we just interpreted. Leaving it in made
  // `zagent memory append -- --help` store the literal text "-- --help".
  const args = sep === -1 ? rest : [...rest.slice(0, sep), ...rest.slice(sep + 1)];
  run(script, nodeArgs, args);
}
// Commands forwarded to packages/cli/zagent.mjs. 'doctor' is implemented there;
// 'login'/'logout'/'app-server' are kernel subcommands we deliberately expose
// unchanged ('app-server' is a headless entry — tui-launch.mjs isInteractive).
// Anything else that names a command gets OUR error — a typo used to reach the
// kernel and come back as "zcode 0.16.5 / Usage: zcode [command]", the wrong
// product's usage text on stderr for the right product's mistake.
const MAIN_ENTRY_COMMANDS = new Set(['doctor', 'login', 'logout', 'app-server']);
if (command && !command.startsWith('-') && !MAIN_ENTRY_COMMANDS.has(command)) {
  console.error(`zagent: unknown command '${command}'`);
  console.error("Run 'zagent help' for the command list.");
  process.exit(2);
}
// Option-led invocations packages/cli/zagent.mjs understands — the kernel entry
// flags it and tui-launch.mjs treat as theirs, so `zagent --mode plan -p "…"`
// reaches the runtime exactly like `zcode` would. ENTRY_FLAGS is the kernel's
// own parser table, verified by execution (see commands.mjs). `--capabilities`
// is NOT there: it only exists on the doctor path, so a bare one is still a
// typo. Any other leading-dash token is a typo (`--verison`, `--bogus`): answer
// it here, exit 2, and never let the kernel print its own usage text for our
// product's mistake.
const capHint = " — did you mean 'zagent doctor --capabilities'?";
if (command && command.startsWith('-') && !entryFlag(command)) {
  const cname = command.split('=')[0];
  console.error(`zagent: unknown option '${cname}'${cname === '--capabilities' ? capHint : didYouMean(cname)}`);
  console.error("Run 'zagent help' for the command list.");
  process.exit(2);
}
// A typo'd option later in a -p argv (`-p hi --efort low`) used to forward
// verbatim into zagent.mjs, where the credential gate answered first — a
// signed-out user got the sign-in card for what is really an unknown flag,
// and a signed-in one got the kernel's own usage text. parseArgs never takes
// a dash-token as an option value ('--target -x' errors 'argument is
// ambiguous'), so every pre-`--` dash-token must name a known flag; refuse
// the first that doesn't before anything downstream can mask it. Glued short
// clusters (`-pfoo`, `-cf`) are kernel-legal (parseArgs expands them) but the
// leading-position check above already pins refusing them — mid-argv holds
// the same line rather than silently widening the divergence.
if (command && entryFlag(command)) {
  const bad = flagArgs.find(a => a.startsWith('-') && a !== '-' && !entryFlag(a));
  if (bad) {
    const name = bad.split('=')[0];
    console.error(`zagent: unknown option '${name}'${name === '--capabilities' ? capHint : didYouMean(name)}`);
    console.error("Run 'zagent help' for the command list.");
    process.exit(2);
  }
}
// What remains: no arguments (interactive TUI), the entry flags above, and the
// routed allowlists.
run('packages/cli/zagent.mjs', [], process.argv.slice(2));
