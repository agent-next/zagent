#!/usr/bin/env node
// Coding Plan quota and account usage, plus legacy desktop billing.
// `reset` also carries the desktop's reset-ticket actions (3.12.1 host contract):
// `reset` = status, `reset use five-hour|week` = consume a ticket, `reset claim` = request one.
import { createInterface } from 'node:readline';
import { billing, resetStatus, resetUse, resetClaim, quotaError, quotaFailureClass, QUOTA_CLASS_HINT, codingPlanStatus, codingPlanUsage } from '../packages/driver/quota.mjs';
import { normalizeReset, resetLine } from '../packages/driver/reset-shape.mjs';
const args = process.argv.slice(2);
let which = 'status', raw = false, days = 7, commandSeen = false, daysSeen = false, yes = false;
let resetAction = null, resetType = null;
async function usage() {
  const u = 'usage: zagent quota [status|usage [--days 1..30]|balance|preview|reset [claim|use five-hour|use week]] [--json] [--yes]';
  // --json: stdout stays machine-readable; a buffered console.log can be lost
  // to process.exit, so the write is flushed first. An invalid token can end
  // the parse before --json is reached, so scan the raw argv, not `raw`.
  if (raw || args.includes('--json'))
    await new Promise((res) => process.stdout.write(JSON.stringify({ error: u, class: null }) + '\n', res));
  console.error(u);
  process.exit(2);
}
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--json' && !raw) raw = true;
  else if (args[i] === '--yes' && !yes) yes = true;
  else if (args[i] === '--days' && !daysSeen) {
    daysSeen = true;
    const value = args[++i];
    if (!/^(?:[1-9]|[12][0-9]|30)$/.test(value ?? '')) await usage();
    days = Number(value);
  } else if (!commandSeen && ['status', 'usage', 'balance', 'preview', 'reset'].includes(args[i])) {
    which = args[i]; commandSeen = true;
  } else if (which === 'reset' && !resetAction && (args[i] === 'use' || args[i] === 'claim')) {
    resetAction = args[i];
  } else if (which === 'reset' && resetAction === 'use' && !resetType &&
             ['five-hour', 'week'].includes(args[i])) {
    resetType = args[i];
  } else await usage();
}
if (daysSeen && which !== 'usage') await usage();
if (resetAction === 'use' && !resetType) await usage();
if (yes && resetAction !== 'use') await usage();
// A consumed reset ticket is a scarce entitlement: interactive runs confirm
// explicitly (default no); piped or --json runs must pass --yes.
if (resetAction === 'use' && !yes) {
  if (raw || !process.stdin.isTTY) {
    const msg = `'reset use ${resetType}' consumes a scarce reset ticket; re-run with --yes to confirm`;
    console.error(`quota: ${msg}`);
    if (raw) await new Promise((res) => process.stdout.write(JSON.stringify({ error: msg, class: null }) + '\n', res));
    process.exit(2);
  }
  const rl = createInterface({ input: process.stdin, output: process.stderr });
  const answer = await new Promise(resolve => rl.question(
    `Consume a ${resetType} reset ticket now? [y/N] `, resolve));
  rl.close();
  if (!/^y(es)?$/i.test(answer.trim())) {
    console.error('quota: reset not confirmed; nothing was consumed');
    process.exit(2);
  }
}
// Escape server-provided strings before terminal output, as JSON output does.
const label = value => JSON.stringify(value ?? 'unknown');
const keyLine = (result) => `Key: ${result.plan?.providerId
  ? `CLI provider ${label(result.plan.providerId)}` +
    (result.plan.name ? ` (${label(result.plan.name)})` : '')
  : `${label(result.keySource)}; the plan name is not derivable from this key source`}`;
try {
  if (which === 'status' || which === 'usage') {
    const result = which === 'status' ? await codingPlanStatus() : await codingPlanUsage({ days });
    if (raw) console.log(JSON.stringify(result, null, 2));
    else {
      if (which === 'status') {
        const pools = result.pools ?? [];
        // Pool identities are service codes; the two a reader actually asks about
        // are the rolling 5-hour window (TOKENS_LIMIT/CREDIT_LIMIT, unit 3,
        // number 5) and the monthly tool-call allowance (TIME_LIMIT, unit 5).
        const fiveHour = pools.find((p) => (p?.type === 'TOKENS_LIMIT' || p?.type === 'CREDIT_LIMIT') && p?.unit === 3 && p?.number === 5);
        const monthly = pools.find((p) => p?.type === 'TIME_LIMIT' && p?.unit === 5);
        const others = pools.filter((p) => p !== fiveHour && p !== monthly);
        if (typeof result.level === 'string' && result.level) console.log(`Plan: ${label(result.level)}`);
        console.log(keyLine(result));
        const now = Date.now();
        const resetIn = (iso) => {
          const ms = Date.parse(iso ?? '');
          if (!Number.isFinite(ms)) return null;
          const mins = Math.round((ms - now) / 60000);
          if (mins <= 0) return 'pending'; // the service has not rolled the window yet
          const h = Math.floor(mins / 60), m = mins % 60;
          return h ? `${h}h ${m}m` : `${m}m`;
        };
        const clockUtc = (iso) => {
          const d = new Date(iso);
          return `${String(d.getUTCHours()).padStart(2, '0')}:${String(d.getUTCMinutes()).padStart(2, '0')} UTC`;
        };
        const monthDay = (iso) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
        const count = (n) => Number(n).toLocaleString('en-US');
        if (!fiveHour || fiveHour.usedPercent == null) {
          console.log('5-hour window: not reported');
        } else {
          const within = resetIn(fiveHour.nextResetAt);
          console.log(`5-hour window: ${fiveHour.usedPercent}% used` +
            (within === 'pending' ? ' · reset pending'
              : within ? ` · resets ${clockUtc(fiveHour.nextResetAt)} (in ${within})` : ''));
        }
        if (!monthly) {
          console.log('Monthly tool calls: not reported');
        } else {
          const counts = monthly.remaining != null && monthly.limit != null
            ? `${count(monthly.remaining)} of ${count(monthly.limit)} left`
            : monthly.usedPercent != null ? `${monthly.usedPercent}% used` : 'not reported';
          const resetMs = Date.parse(monthly.nextResetAt ?? '');
          console.log(`Monthly tool calls: ${counts}` +
            (Number.isFinite(resetMs) ? ` · resets ${monthDay(resetMs)}` : ''));
        }
        if (others.length) console.log('Other plan limits also reported — see zagent quota --json.');
      } else {
        console.log(keyLine(result));
        console.log(`${result.source} — account aggregate (${result.observedAt})`);
        console.log(`${result.requestedRange.startTime} through ${result.requestedRange.endTime} (${result.timeZone}); current day is partial.`);
        console.log(`Calls: ${result.calls}; reported tokens: ${result.reportedTokens}`);
        if (result.models === null) console.log('Model breakdown: unknown');
        else for (const model of result.models) console.log(`${label(model.model)}: ${model.reportedTokens} reported tokens`);
        console.log(result.attribution);
        console.log(result.billing);
      }
    }
  } else {
    const { status, body } = which !== 'reset' ? await billing(which)
      : resetAction === 'use' ? await resetUse(resetType)
      : resetAction === 'claim' ? await resetClaim()
      : await resetStatus();
    // 3301 on a 2xx is a normal claim outcome (not granted, next_try_at), not a failure.
    const denied = resetAction === 'claim' && status >= 200 && status < 300 && body?.code === 3301;
    const error = denied ? null : quotaError({ status, body });
    if (error) {
      // F11: name the problem class (sign-in vs quota window) with its fix.
      // F15: the class is also a JSON field — after the spread so a server
      // body cannot spoof it; null when the failure is unclassified.
      const cls = quotaFailureClass({ status, body });
      console.log(JSON.stringify({ ...body, http: status, class: cls }, null, 1));
      console.error(`quota: ${error}${cls ? ` — ${QUOTA_CLASS_HINT[cls]}` : ''}`);
      process.exitCode = 1;
    } else if (which === 'reset' && !raw && resetAction) {
      console.log(JSON.stringify({ ...body, http: status }, null, 1));
      if (resetAction === 'use') {
        console.log(body?.data?.used === true
          ? `${resetType} reset used — the quota window restarts now`
          : 'reset not confirmed used — inspect the JSON above');
      } else {
        const granted = body?.data?.granted === true;
        const next = body?.data?.next_try_at;
        // next_try_at is epoch-seconds in the host schema; tolerate epoch-ms too.
        const nextMs = Number.isFinite(next) ? (next > 1e12 ? next : next * 1000) : null;
        const nextIso = nextMs && Number.isFinite(new Date(nextMs).getTime())
          ? `; next try at ${new Date(nextMs).toISOString()}` : '';
        console.log(granted ? 'reset ticket claimed' : `no reset granted${nextIso}`);
      }
    } else if (which === 'reset' && !raw) {
      const reset = normalizeReset(body);
      console.log(JSON.stringify({ ...reset, http: status }, null, 1));
      console.log(resetLine(reset));
    } else {
      console.log(JSON.stringify({ ...body, http: status }, null, 1));
    }
  }
} catch (error) {
  const msg = String(error?.message ?? error);
  // --json: stdout stays machine-readable; the class rides the envelope too.
  if (raw) console.log(JSON.stringify({ error: msg, class: error?.quotaClass ?? null }));
  console.error(`quota: ${msg}`);
  process.exitCode = 1;
}
