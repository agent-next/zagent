#!/usr/bin/env node
// zquota — coding-plan quota/entitlement panel (B2/B2b). Usage: node bin/zquota [balance|preview|reset] [--json]
import { billing, resetStatus, quotaError } from '../packages/driver/quota.mjs';
import { normalizeReset, resetLine } from '../packages/driver/reset-shape.mjs';
const args = process.argv.slice(2);
const positionals = args.filter(arg => arg !== '--json');
const which = positionals[0] ?? 'balance';
const raw = args.includes('--json');
if (positionals.length > 1 || !['balance', 'preview', 'reset'].includes(which)) {
  console.error('usage: zagent quota [balance|preview|reset] [--json]');
  process.exit(2);
}
try {
  const { status, body } = which === 'reset' ? await resetStatus() : await billing(which);
  const error = quotaError({ status, body });
  if (error) {
    console.log(JSON.stringify({ http: status, ...body }, null, 1));
    console.error(`quota: ${error}`);
    process.exitCode = 1;
  } else if (which === 'reset' && !raw) {
    const reset = normalizeReset(body);
    console.log(JSON.stringify({ http: status, ...reset }, null, 1));
    console.log(resetLine(reset));
  } else {
    console.log(JSON.stringify({ http: status, ...body }, null, 1));
  }
} catch (error) {
  console.error(`quota: ${error.message}`);
  process.exitCode = 1;
}
