#!/usr/bin/env node
// zagent — single entry (also installed as `za`).
//
// This was a bash script. npm generated a .cmd shim for it on Windows that
// resolves the interpreter to `bash`, so `npm install -g zagent` succeeded there
// and every invocation then died with "'bash' is not recognized" — while
// package.json declared no `os` field, so npm issued no warning and the README
// advertised cross-platform support. It also used `readlink -f`, which BSD
// readlink (older macOS) does not support: `$R` silently became the parent of the
// cwd rather than the package root.
//
// Node is already a hard dependency, so the dispatcher is written in it.

import { spawnSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const [command, ...rest] = process.argv.slice(2);

/** Subcommand -> the script that implements it, and whether it needs node:sqlite. */
const ROUTES = {
  quota: ['bin/zquota'],
  sessions: ['bin/zcodes', '--experimental-sqlite'],
  diff: ['packages/cli/zmax-diff.mjs'],
  onboard: ['packages/cli/zmax-onboard.mjs'],
  cron: ['packages/cli/zmax-cron.mjs'],
  task: ['packages/cli/zmax-task.mjs', '--experimental-sqlite'],
  memory: ['packages/cli/zmax-memory.mjs'],
  offpeak: ['packages/cli/zmax-offpeak.mjs'],
  models: ['packages/cli/zmax-models.mjs'],
  help: ['packages/cli/zmax-help.mjs'],
  plugins: ['packages/cli/zmax-plugins.mjs'],
};

/** Present in the source repo, deliberately not part of this distribution. */
const SOURCE_ONLY = new Set(['telegram', 'feishu', 'wechat', 'compact', 'dcompact', 'plugin-validate']);

/** Run a script under this same Node and inherit its exit status. */
const run = (script, nodeArgs = [], args = []) => {
  const r = spawnSync(process.execPath, [...nodeArgs, path.join(root, script), ...args], { stdio: 'inherit' });
  if (r.error) { console.error(`zagent: ${r.error.message}`); process.exit(1); }
  // A signal death is a failure, not a success.
  process.exit(r.status ?? (r.signal ? 1 : 0));
};

if (command === '--version' || command === '-V' || command === 'version') {
  process.stdout.write(`${JSON.parse(readFileSync(path.join(root, 'package.json'), 'utf8')).version}\n`);
  process.exit(0);
}
if (command === '--help' || command === '-h') run('packages/cli/zmax-help.mjs');
if (SOURCE_ONLY.has(command)) {
  console.error(`zagent: ${command} is source-only experimental functionality, not included in this public candidate.`);
  process.exit(2);
}
if (Object.hasOwn(ROUTES, command)) {
  const [script, ...nodeArgs] = ROUTES[command];
  run(script, nodeArgs, rest);
}
// Everything else, including no arguments at all, is the main entry.
run('packages/cli/zmax.mjs', [], process.argv.slice(2));
